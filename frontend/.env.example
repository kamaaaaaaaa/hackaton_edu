# ---- Готов к толчку · frontend env ----
# Скопируй в .env и при необходимости поменяй значения.

# Использовать локальные моки вместо реального API.
# true  — данные берутся из src/mocks (бэкенд не нужен)
# false — запросы идут на VITE_API_URL
VITE_USE_MOCKS=true

# Базовый URL бэкенда (используется только при VITE_USE_MOCKS=false).
# Пример для локального Django: http://127.0.0.1:8000/api
VITE_API_URL=http://127.0.0.1:8000/api

# Ключ TomTom Maps (Map Display API) для тайлов карты.
# Получить: https://developer.tomtom.com -> MyTomTom -> Keys -> API & SDK Keys
VITE_TOMTOM_KEY=
