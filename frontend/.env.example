# ---- Готов к толчку · frontend env ----
# Скопируй в .env (cp .env.example .env). Без .env всё тоже работает:
# карта, поиск и маршруты — на открытых сервисах OpenStreetMap, ключи не нужны.

# ---------- Бэкенд (Django) ----------
# Адрес API. «/api» — тот же домен: на Render Django отдаёт и сайт, и API,
# а при `npm run dev` / `npm run preview` Vite проксирует /api на бэкенд.
VITE_API_URL=/api

# Куда dev-сервер проксирует /api. По умолчанию — бэкенд команды на Render.
# Для локального Django: http://127.0.0.1:8000
VITE_DEV_API_PROXY=https://hackathon-base.onrender.com

# true — тревога только демо (кнопка «Симулировать тревогу»), без запросов /alert/active/
VITE_USE_MOCKS=true

# ---------- Карта, поиск, маршруты ----------
# osm (по умолчанию) — OpenFreeMap + Photon/Nominatim + Valhalla, ключи не нужны.
# tomtom — нужен VITE_TOMTOM_KEY с доступом к Map Display / Search / Routing API.
VITE_MAP_PROVIDER=osm
VITE_SEARCH_PROVIDER=osm
VITE_ROUTING_PROVIDER=osm

# Ключ TomTom (необязательно). Получить: https://developer.tomtom.com → Keys.
# Ограничьте ключ по домену в кабинете TomTom — он виден в коде страницы.
VITE_TOMTOM_KEY=
