{
  "name": "gotov-k-tolchku-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend for «Готов к толчку» — earthquake preparedness web app for Almaty",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:django": "tsc --noEmit && vite build --outDir ../frontend_dist --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "geocode": "node scripts/geocode-points.ts",
    "geocode:pending": "node scripts/geocode-points.ts --pending",
    "geocode:osm": "node scripts/geocode-points.ts --provider=nominatim",
    "points:find": "node scripts/find-review-points.ts",
    "points:apply": "node scripts/apply-osm-objects.ts",
    "houses": "node scripts/build-houses.ts",
    "houses:routes": "node scripts/refresh-house-routes.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "framer-motion": "^13.4.1",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.26",
    "maplibre-gl": "^6.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
