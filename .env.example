# Copy this file to .env and fill in real values for local development.
# Generate a SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE_URL is optional locally (defaults to sqlite). In production on
# Render, this is injected automatically for the managed Postgres instance,
# e.g. postgres://user:password@host:5432/dbname
# DATABASE_URL=
